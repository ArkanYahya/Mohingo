      "meaningAr": "المضارع المستمر للترتيبات الثابتة",
      "introducedIn": "A2-U6-L2",
      "examples": [
        {
          "en": "We are meeting the guide at nine.",
          "ar": "سنلتقي المرشد في التاسعة."
        }
      ]
    },
    {
      "id": "A2.G.WILL_DECISION_OFFER",
      "form": "will for instant decisions and offers",
      "meaningAr": "will للقرار اللحظي والعرض",
      "introducedIn": "A2-U6-L3",
      "examples": [
        {
          "en": "I'll take the later train.",
          "ar": "سآخذ القطار اللاحق."
        }
      ]
    },
    {
      "id": "A2.G.FUTURE_CONTRAST",
      "form": "going to vs present continuous vs will",
      "meaningAr": "المقارنة بين صيغ المستقبل",
      "introducedIn": "A2-U6-L3",
      "examples": [
        {
          "en": "I'm going to travel; I'm leaving Friday; I'll book now.",
          "ar": "أنوي السفر؛ سأغادر الجمعة؛ سأحجز الآن."
        }
      ]
    },
    {
      "id": "A2.G.FIRST_CONDITIONAL_INTRO",
      "form": "if + present, will + verb",
      "meaningAr": "مقدمة الشرط الأول",
