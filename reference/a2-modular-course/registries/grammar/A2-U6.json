      "examples": [
        {
          "en": "If it rains, we'll visit the museum.",
          "ar": "إذا أمطرت فسنزور المتحف."
        }
      ]
    },
    {
      "id": "A2.G.FUTURE_TIME_CLAUSE",
      "form": "when/after/before + present",
      "meaningAr": "عبارات الزمن المستقبلية",
      "introducedIn": "A2-U6-L5",
      "examples": [
        {
          "en": "Call me when you arrive.",
