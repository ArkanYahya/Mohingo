      "examples": [
        {
          "en": "We didn't stay long.",
          "ar": "لم نبق طويلاً."
        }
      ]
    },
    {
      "id": "A2.G.PAST_TIME_LINKERS",
      "form": "first, then, after that, finally",
      "meaningAr": "روابط تسلسل الماضي",
      "introducedIn": "A2-U2-L5",
      "examples": [
        {
